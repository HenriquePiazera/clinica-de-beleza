# Ambiente local — gerado por `npm run setup` / `npm run dev`
# Produção (Vercel): ver docs/DEPLOY_VERCEL.md — use Postgres Neon/Supabase, não prisma local.

DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

ENCRYPTION_MASTER_KEY="generate-with-openssl-rand-base64-32"

BILLING_ENABLED=false

# Local: false (login direto). Vercel demo: true + links /demo/<token>
DEMO_MODE=false
DEMO_SESSION_HOURS=2
DEMO_BYPASS_EMAILS="demo@assistente-admin.local"

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:demo@assistente-admin.local"

CRON_SECRET="generate-with-openssl-rand-hex-32"

RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

PLATFORM_OWNER_EMAILS="demo@assistente-admin.local"
BETA_ALLOWED_EMAILS="demo@assistente-admin.local"
