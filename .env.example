# Ambiente local — gerado por `npm run setup` / `npm run dev`
# Produção (Vercel): ver docs/DEPLOY_VERCEL.md — Postgres Neon NOVO, segredos NOVOS.

DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51214/template1?sslmode=disable"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

ENCRYPTION_MASTER_KEY="generate-with-openssl-rand-base64-32"

BILLING_ENABLED=false

# Produção do cliente: sempre false. true só para links temporários /demo/<token>
DEMO_MODE=false
DEMO_SESSION_HOURS=2
DEMO_BYPASS_EMAILS="mariana@clinica-mariana.local"

VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:mariana@clinica-mariana.local"

CRON_SECRET="generate-with-openssl-rand-hex-32"

# SMS simulado (custo R$ 0) — grava na caixa /settings/notifications/sms
MOCK_SMS_ENABLED=true

RESEND_API_KEY=""
# Teste: onboarding@resend.dev (só para o e-mail da conta Resend).
# Produção: e-mail de domínio verificado em resend.com/domains.
# Nunca use @gmail.com / @outlook.com como From.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# --- Storage (produção / Vercel) ---
# Local: pasta storage/ (padrão sem essas vars).
# Produção: bucket privado clinic-files + service_role.
# Criar bucket: npx tsx scripts/ensure-supabase-storage.mts
SUPABASE_URL="https://SEU_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="clinic-files"

PLATFORM_OWNER_EMAILS="mariana@clinica-mariana.local"
BETA_ALLOWED_EMAILS="mariana@clinica-mariana.local,camila@clinica-mariana.local,juliana@clinica-mariana.local"
