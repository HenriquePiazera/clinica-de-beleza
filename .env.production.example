# Copie estas variáveis no painel da Vercel → Settings → Environment Variables
# (Production). NÃO use o .env local. Gere segredos NOVOS — nunca reutilize demo.

# --- Obrigatórias ---
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="COLE_openssl_rand_base64_32"
NEXTAUTH_SECRET="MESMO_VALOR_DE_AUTH_SECRET"
NEXTAUTH_URL="https://SEU-PROJETO.vercel.app"

ENCRYPTION_MASTER_KEY="COLE_openssl_rand_base64_32_DIFERENTE"

BILLING_ENABLED=false
DEMO_MODE=false

CRON_SECRET="COLE_openssl_rand_hex_32"

# Contas do seed (teste). Troque pelos e-mails reais depois.
PLATFORM_OWNER_EMAILS="mariana@clinica-mariana.local"
BETA_ALLOWED_EMAILS="mariana@clinica-mariana.local,camila@clinica-mariana.local,juliana@clinica-mariana.local"
DEMO_BYPASS_EMAILS="mariana@clinica-mariana.local"

# --- Recomendadas (e-mail / Web Push) ---
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="onboarding@resend.dev"
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:mariana@clinica-mariana.local"

# Gerar VAPID localmente: npm run setup:notifications
# Gerar segredos: npm run deploy:secrets
